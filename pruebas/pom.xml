<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.turnos.qa</groupId>
    <artifactId>pruebas</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Fila Virtual de Turnos - Suite E2E Selenium</name>
    <description>Pruebas E2E y funcionales automatizadas con Selenium WebDriver 4 y JUnit 5</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <selenium.version>4.25.0</selenium.version>
        <junit.jupiter.version>5.11.2</junit.jupiter.version>
        <webdrivermanager.version>5.9.2</webdrivermanager.version>
        <surefire.plugin.version>3.5.1</surefire.plugin.version>
        <base.url>http://localhost:4200</base.url>
        <api.url>http://localhost:8080/api/turnos</api.url>
        <headless>false</headless>
        <pausa.ms>3000</pausa.ms>
    </properties>

    <dependencies>
        <!-- Selenium WebDriver 4.x (incluye Selenium Manager nativo) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- WebDriverManager para gestión automática de ChromeDriver en local y CI/CD -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 (Jupiter API y Engine) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Surefire para ejecutar pruebas JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- URL del Frontend Angular (por defecto http://localhost:4200) -->
                        <base.url>${base.url}</base.url>
                        <!-- Modo headless para CI/CD (por defecto false) -->
                        <headless>${headless}</headless>
                        <!-- Tiempo mínimo en pantalla por paso en Chrome (por defecto 3000 ms = 3s) -->
                        <pausa.ms>${pausa.ms}</pausa.ms>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
